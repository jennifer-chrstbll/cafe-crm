# Database configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.YOUR_SUPABASE_ID.supabase.co:5432/postgres

# JWT Security
JWT_SECRET_KEY=YOUR_SECURE_RANDOM_JWT_SECRET_KEY_HERE

# Face Recognition Service URL
FACEREC_URL=http://localhost:5001

# Environment
ENVIRONMENT=development
