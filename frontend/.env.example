# Copy to .env.local (local dev) and set the same names in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Server only. Supabase → Project Settings → API → service_role. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Signs login sessions. At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=<long-random-secret>

# Shared secret for the edge devices (UNO Q, Raspberry Pi) calling /api/association/bind.
# Put the same value in uno_q/.env (DEVICE_API_KEY) on the board.
DEVICE_API_KEY=<long-random-secret>
